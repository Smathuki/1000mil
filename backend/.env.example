# Copy to .env (or set in your deployment) — every value has a safe local default.
MAKAO_DATABASE_URL=sqlite:///./makao.db          # postgresql+psycopg://user:pass@host/makao in production
MAKAO_SECRET_KEY=change-me                       # signs iCal export links and smart-lock codes
MAKAO_CORS_ORIGINS=http://localhost:5173
MAKAO_PUBLIC_BASE_URL=http://localhost:5173      # used in WhatsApp reply links
MAKAO_SEED=1                                     # seed demo data into an empty database on boot

# Commercials
MAKAO_COMMISSION_RATE=0.18
MAKAO_FULL_SERVICE_RATE=0.10

# Payments: sandbox simulates M-Pesa/card end to end; live calls Safaricom Daraja.
MAKAO_PAYMENTS_MODE=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain/api/payments/mpesa/callback

# WhatsApp Cloud API: sandbox logs replies; live sends them.
MAKAO_MESSAGING_MODE=sandbox
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=makao-verify
